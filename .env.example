# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── Chat Coach links ──────────────────────────────────────────────────────
# App Store listing used by iOS download calls to action
NEXT_PUBLIC_CHATCOACH_APP_STORE_URL="https://apps.apple.com/app/id0000000000"

# Chrome Web Store listing used by Chrome download calls to action
NEXT_PUBLIC_CHATCOACH_WEB_LINK="https://chromewebstore.google.com/detail/your-extension-id"

# Cal.com, Calendly, or similar URL used by discovery-call calls to action
NEXT_PUBLIC_CALL_LINK="https://cal.com/your-handle/discovery-call"

# ─── Email (contact form + waitlist) ────────────────────────────────────────
# Gmail address that sends emails
GMAIL_USER="you@gmail.com"
# Google account → Security → 2-Step Verification → App Passwords
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Where contact form submissions are delivered (defaults to GMAIL_USER if unset)
CONTACT_EMAIL="bibo@bibotecture.com"

# Where waitlist signups are delivered (defaults to CONTACT_EMAIL if unset)
WAITLIST_EMAIL="bibo@bibotecture.com"
